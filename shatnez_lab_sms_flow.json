{
  "description": "Shatnez Laboratory SMS Auto-responder",
  "flags": {
    "allow_concurrent_calls": true
  },
  "initial_state": "Trigger",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "properties": {
        "offset": {
          "x": 0,
          "y": 0
        }
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "handle_incoming_sms"
        },
        {
          "event": "incomingCall"
        },
        {
          "event": "incomingConversation"
        },
        {
          "event": "request"
        }
      ]
    },
    {
      "name": "handle_incoming_sms",
      "type": "make-http-request",
      "properties": {
        "add_twilio_auth": false,
        "content_type": "application/x-www-form-urlencoded;charset=utf-8",
        "method": "POST",
        "offset": {
          "x": 40,
          "y": 150
        },
        "parameters": [
          {
            "key": "phone",
            "value": "{{trigger.message.From}}"
          },
          {
            "key": "msg",
            "value": "{{trigger.message.Body}}"
          }
        ],
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=incoming_sms"
      },
      "transitions": [
        {
          "event": "success"
        },
        {
          "event": "failed"
        }
      ]
    }
  ]
}
