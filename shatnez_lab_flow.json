            "value": "{{contact.channel.address}}"
          },
          {
            "key": "SpeechResult",
            "value": "{{widgets.gather_delivery_speech.SpeechResult}}"
          }
        ],
        "url": "https://www.theshatnezlab.com/api/twilio/studio?action=save_delivery"
      },
      "transitions": [
        {
          "event": "success",
          "next": "play_delivery_success"
        },
        {
          "event": "failed",
          "next": "play_delivery_success"
        }
      ],
      "type": "make-http-request"
    },
    {
      "name": "play_delivery_success",
      "properties": {
        "language": "en-US",
        "loop": 1,
        "offset": {
          "x": -1500,
          "y": -500
        },
        "say": "Thank you. Your address has been recorded and your request is received. We will contact you shortly to arrange. Goodbye.",
        "voice": "Polly.Matthew"
      },
      "transitions": [
        {
          "event": "audioComplete"
        }
      ],
      "type": "say-play"
    }
  ]
