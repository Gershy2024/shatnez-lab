{
  "description": "Shatnez Laboratory Multilingual IVR with Admin Menu",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "properties": {
        "offset": {
          "x": 0,
          "y": -150
        }
      },
      "transitions": [
        {
          "event": "incomingCall",
          "next": "welcome_menu"
        },
        {
          "event": "incomingMessage"
        },
        {
          "event": "incomingConversation"
        },
        {
          "event": "request"
        }
      ]
    },
    {
      "name": "welcome_menu",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 0,
          "y": 100
        },
        "number_of_digits": 1,
        "finish_on_key": "#",
        "timeout": 5,
        "say": "Welcome to The Shatnez Lab. Press 1 for drop-off information. Press 2 to check your order status. Press 3 to hear about VIP services. Press 0 to speak with a representative. Press 9 for admin menu.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "split_menu_keys"
        },
        {
          "event": "timeout",
          "next": "check_hours"
        }
      ]
    },
    {
      "name": "split_menu_keys",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 0,
          "y": 350
        },
        "variable_to_test": "{{widgets.welcome_menu.Digits}}"
      },
      "transitions": [
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 1",
              "arguments": [
                "1"
              ],
              "type": "equal_to"
            }
          ],
          "next": "log_keypress_1"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 2",
              "arguments": [
                "2"
              ],
              "type": "equal_to"
            }
          ],
          "next": "ask_lookup_choice"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 3",
              "arguments": [
                "3"
              ],
              "type": "equal_to"
            }
          ],
          "next": "log_keypress_3"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 0",
              "arguments": [
                "0"
              ],
              "type": "equal_to"
            }
          ],
          "next": "check_hours"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 9",
              "arguments": [
                "9"
              ],
              "type": "equal_to"
            }
          ],
          "next": "split_admin_caller_id"
        },
        {
          "event": "noMatch",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "play_info",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": -400,
          "y": 600
        },
        "say": "Drop-off Information: You can drop off your garments at our main lab at any time. Testing usually takes 2 to 3 business days. The base price is 15 dollars per item.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "play_vip",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": -200,
          "y": 600
        },
        "say": "Exclusive VIP Services: We offer express same-day testing, and at-home pick-up and delivery services in selected locations.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "connect_call_1",
      "type": "connect-call-to",
      "properties": {
        "offset": {
          "x": 0,
          "y": 600
        },
        "caller_id": "{{widgets.check_hours.parsed.callerId}}",
        "noun": "number",
        "to": "{{widgets.check_hours.parsed.forwardingNumber}}"
      },
      "transitions": [
        {
          "event": "connectedCallEnded"
        },
        {
          "event": "callerHungUp"
        }
      ]
    },
    {
      "name": "ask_lookup_choice",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 300,
          "y": 600
        },
        "number_of_digits": 1,
        "finish_on_key": "#",
        "timeout": 5,
        "say": "<speak>I see you are calling from <say-as interpret-as=\"digits\">{{contact.channel.address}}</say-as>. To search for orders using this phone number, press 1. To search using a different phone number or order number, press 2.</speak>",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "split_lookup_choice"
        },
        {
          "event": "timeout",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "split_lookup_choice",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 300,
          "y": 800
        },
        "variable_to_test": "{{widgets.ask_lookup_choice.Digits}}"
      },
      "transitions": [
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 1",
              "arguments": [
                "1"
              ],
              "type": "equal_to"
            }
          ],
          "next": "caller_lookup"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 2",
              "arguments": [
                "2"
              ],
              "type": "equal_to"
            }
          ],
          "next": "ask_manual_query"
        },
        {
          "event": "noMatch",
          "next": "ask_lookup_choice"
        }
      ]
    },
    {
      "name": "caller_lookup",
      "type": "make-http-request",
      "properties": {
        "offset": {
          "x": 150,
          "y": 1000
        },
        "method": "POST",
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=caller_lookup",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "phone",
            "value": "{{contact.channel.address}}"
          }
        ]
      },
      "transitions": [
        {
          "event": "success",
          "next": "read_caller_orders"
        },
        {
          "event": "failed",
          "next": "ask_manual_query"
        }
      ]
    },
    {
      "name": "read_caller_orders",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 150,
          "y": 1200
        },
        "say": "{{widgets.caller_lookup.parsed.messageEn}}",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "ask_manual_query",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 450,
          "y": 1000
        },
        "number_of_digits": 10,
        "finish_on_key": "#",
        "timeout": 10,
        "say": "Please enter the phone number or order ID followed by the pound key.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "manual_lookup"
        },
        {
          "event": "timeout",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "manual_lookup",
      "type": "make-http-request",
      "properties": {
        "offset": {
          "x": 450,
          "y": 1200
        },
        "method": "POST",
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=manual_lookup",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "query",
            "value": "{{widgets.ask_manual_query.Digits}}"
          }
        ]
      },
      "transitions": [
        {
          "event": "success",
          "next": "read_manual_orders"
        },
        {
          "event": "failed",
          "next": "say_play_not_found"
        }
      ]
    },
    {
      "name": "read_manual_orders",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 450,
          "y": 1400
        },
        "say": "{{widgets.manual_lookup.parsed.messageEn}}",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "say_play_not_found",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 650,
          "y": 1400
        },
        "say": "We could not find any order with that number. Returning to the main menu.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "ask_admin_pin",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 800,
          "y": 600
        },
        "number_of_digits": 4,
        "finish_on_key": "#",
        "timeout": 10,
        "say": "Please enter your 4 digit admin PIN followed by the pound key.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "verify_pin"
        },
        {
          "event": "timeout",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "verify_pin",
      "type": "make-http-request",
      "properties": {
        "offset": {
          "x": 800,
          "y": 800
        },
        "method": "POST",
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=admin_login",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "pin",
            "value": "{{widgets.ask_admin_pin.Digits}}"
          }
        ]
      },
      "transitions": [
        {
          "event": "success",
          "next": "check_admin_auth"
        },
        {
          "event": "failed",
          "next": "bad_pin_msg"
        }
      ]
    },
    {
      "name": "check_admin_auth",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 800,
          "y": 1000
        },
        "variable_to_test": "{{widgets.verify_pin.parsed.authenticated}}"
      },
      "transitions": [
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If Auth Success",
              "arguments": [
                "true"
              ],
              "type": "equal_to"
            }
          ],
          "next": "admin"
        },
        {
          "event": "noMatch",
          "next": "bad_pin_msg"
        }
      ]
    },
    {
      "name": "bad_pin_msg",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 650,
          "y": 1000
        },
        "say": "{{widgets.verify_pin.parsed.messageEn}} Returning to the main menu.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "admin",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 950,
          "y": 1200
        },
        "number_of_digits": 1,
        "finish_on_key": "#",
        "timeout": 10,
        "say": "Admin menu. Press 1 to hear recent orders. Press 2 to add a new order. Press 3 to update an order status. Press star to return to the main menu.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "split_29"
        },
        {
          "event": "timeout",
          "next": "welcome_menu"
        }
      ]
    },
    {
      "name": "split_29",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 950,
          "y": 1400
        },
        "variable_to_test": "{{widgets.admin.Digits}}"
      },
      "transitions": [
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 1",
              "arguments": [
                "1"
              ],
              "type": "equal_to"
            }
          ],
          "next": "admin_get_recent"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 2",
              "arguments": [
                "2"
              ],
              "type": "equal_to"
            }
          ],
          "next": "admin_ask_add_phone"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If 3",
              "arguments": [
                "3"
              ],
              "type": "equal_to"
            }
          ],
          "next": "admin_ask_update_id"
        },
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If Star",
              "arguments": [
                "*"
              ],
              "type": "contains"
            }
          ],
          "next": "welcome_menu"
        },
        {
          "event": "noMatch",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_get_recent",
      "type": "make-http-request",
      "properties": {
        "offset": {
          "x": 800,
          "y": 1600
        },
        "method": "POST",
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=admin_get_recent",
        "content_type": "application/x-www-form-urlencoded"
      },
      "transitions": [
        {
          "event": "success",
          "next": "read_recent_orders"
        },
        {
          "event": "failed",
          "next": "admin"
        }
      ]
    },
    {
      "name": "read_recent_orders",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 800,
          "y": 1800
        },
        "say": "{{widgets.admin_get_recent.parsed.messageEn}}",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_ask_add_id",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 1000,
          "y": 1600
        },
        "number_of_digits": 10,
        "finish_on_key": "#",
        "timeout": 15,
        "say": "Please enter the new ten digit order ID followed by the pound key.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "admin_ask_add_phone"
        },
        {
          "event": "timeout",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_ask_add_phone",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 1000,
          "y": 1800
        },
        "number_of_digits": 10,
        "finish_on_key": "#",
        "timeout": 15,
        "say": "Please enter the customer's ten digit phone number followed by the pound key.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "admin_add_order_http"
        },
        {
          "event": "timeout",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_add_order_http",
      "type": "make-http-request",
      "properties": {
        "offset": {
          "x": 1000,
          "y": 2000
        },
        "method": "POST",
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=admin_add_order",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "orderId",
            "value": "{{widgets.admin_ask_add_phone.Digits}}"
          },
          {
            "key": "customerPhone",
            "value": "{{widgets.admin_ask_add_phone.Digits}}"
          }
        ]
      },
      "transitions": [
        {
          "event": "success",
          "next": "say_add_order_success"
        },
        {
          "event": "failed",
          "next": "say_add_order_fail"
        }
      ]
    },
    {
      "name": "say_add_order_success",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 900,
          "y": 2200
        },
        "say": "{{widgets.admin_add_order_http.parsed.messageEn}}",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "admin"
        }
      ]
    },
    {
      "name": "say_add_order_fail",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 1100,
          "y": 2200
        },
        "say": "Failed to add order. Returning to the admin menu.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_ask_update_id",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 1300,
          "y": 1600
        },
        "number_of_digits": 10,
        "finish_on_key": "#",
        "timeout": 15,
        "say": "Please enter the ten digit order ID you would like to update, followed by the pound key.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "admin_ask_update_status"
        },
        {
          "event": "timeout",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_ask_update_status",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 1300,
          "y": 1800
        },
        "number_of_digits": 1,
        "finish_on_key": "#",
        "timeout": 15,
        "say": "Enter the status digit. Press 1 for received, 2 for testing, 3 for review, 4 for ready, 5 for delivered, or 6 for attention needed.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "admin_ask_update_result"
        },
        {
          "event": "timeout",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_ask_update_result",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 1300,
          "y": 2000
        },
        "number_of_digits": 1,
        "finish_on_key": "#",
        "timeout": 15,
        "say": "Enter the result selection. Press 1 for clean, 2 if shatnez was found, 3 to request a call, or star to keep the current result.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "admin_split_status_for_notify"
        },
        {
          "event": "timeout",
          "next": "admin_split_status_for_notify"
        }
      ]
    },
    {
      "name": "admin_update_order_http",
      "type": "make-http-request",
      "properties": {
        "offset": {
          "x": 1300,
          "y": 2200
        },
        "method": "POST",
        "url": "https://shatnez-lab.vercel.app/api/twilio/studio?action=admin_update_order",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "orderId",
            "value": "{{widgets.admin_ask_update_id.Digits}}"
          },
          {
            "key": "statusDigit",
            "value": "{{widgets.admin_ask_update_status.Digits}}"
          },
          {
            "key": "resultSelection",
            "value": "{{widgets.admin_ask_update_result.Digits}}"
          },
          {
            "key": "notifyDigit",
            "value": "{{widgets.admin_ask_notify_customer.Digits}}"
          }
        ]
      },
      "transitions": [
        {
          "event": "success",
          "next": "say_update_success"
        },
        {
          "event": "failed",
          "next": "say_update_fail"
        }
      ]
    },
    {
      "name": "say_update_success",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 1200,
          "y": 2400
        },
        "say": "{{widgets.admin_update_order_http.parsed.messageEn}}",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "admin"
        }
      ]
    },
    {
      "name": "say_update_fail",
      "type": "say-play",
      "properties": {
        "offset": {
          "x": 1400,
          "y": 2400
        },
        "say": "Failed to update order. Returning to the admin menu.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "audioComplete",
          "next": "admin"
        }
      ]
    },
    {
      "name": "admin_ask_notify_customer",
      "type": "gather-input-on-call",
      "properties": {
        "offset": {
          "x": 1300,
          "y": 2100
        },
        "number_of_digits": 1,
        "finish_on_key": "#",
        "timeout": 10,
        "say": "Press 1 to notify the customer automatically, or press 2 to skip notification.",
        "voice": "Polly.Joey",
        "language": "en-US"
      },
      "transitions": [
        {
          "event": "keypress",
          "next": "admin_update_order_http"
        },
        {
          "event": "timeout",
          "next": "admin_update_order_http"
        }
      ]
    },
    {
      "name": "admin_split_status_for_notify",
      "type": "split-based-on",
      "properties": {
        "offset": {
          "x": 1300,
          "y": 2050
        },
        "input": "{{widgets.admin_ask_update_status.Digits}}"
      },
      "transitions": [
        {
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If value equal_to 4",
              "arguments": [
                "{{widgets.admin_ask_update_status.Digits}}"
              ],
